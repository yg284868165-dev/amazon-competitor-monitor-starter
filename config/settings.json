    "keyword_position_alert": 10,
    "missing_confirmations": 2
  },
  "auto_retry": {
    "enabled": true,
    "delay_seconds": 300
  },
  "retention": {
    "history_days": 30,
    "diagnostics_days": 30,
    "logs_days": 30
