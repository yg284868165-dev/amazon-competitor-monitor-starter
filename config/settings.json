{
  "amazon": {
    "base_url": "https://www.amazon.com",
    "postal_code": "90001",
    "language": "en-US",
    "currency": "USD",
    "headless": false,
    "chrome_executable": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "navigation_timeout_ms": 45000,
